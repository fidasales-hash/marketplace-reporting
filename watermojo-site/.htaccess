# Watermojo — static site redirect rules (use this for cPanel/Apache hosting)
Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Remove www (ensure canonical is non-www)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Redirect WordPress admin / system paths
RewriteRule ^wp-admin(/.*)?$ https://watermojo.co.za/ [R=301,L]
RewriteRule ^wp-login\.php$ https://watermojo.co.za/ [R=301,L]
RewriteRule ^wp-json(/.*)?$ https://watermojo.co.za/ [R=301,L]
RewriteRule ^xmlrpc\.php$ https://watermojo.co.za/ [R=301,L]
RewriteRule ^feed(/.*)?$ https://watermojo.co.za/ [R=301,L]

# Redirect old Yoast sitemaps to new sitemap
RewriteRule ^sitemap_index\.xml$ https://watermojo.co.za/sitemap.xml [R=301,L]
RewriteRule ^[a-z-]+-sitemap\.xml$ https://watermojo.co.za/sitemap.xml [R=301,L]

# Redirect WordPress taxonomy / archive pages
RewriteRule ^author/(.+)/?$ https://watermojo.co.za/ [R=301,L]
RewriteRule ^category/(.+)/?$ https://watermojo.co.za/ [R=301,L]
RewriteRule ^tag/(.+)/?$ https://watermojo.co.za/ [R=301,L]

# Redirect old blog posts (date-based WordPress URLs)
RewriteRule ^[0-9]{4}/[0-9]{2}/(.+)/?$ https://watermojo.co.za/ [R=301,L]

# Serve existing static files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect any other unrecognised path to homepage
RewriteRule ^ https://watermojo.co.za/ [R=301,L]
