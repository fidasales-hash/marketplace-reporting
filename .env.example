# Supabase (required for Vercel deployment; optional for local dev — falls back to data/db.json)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Takealot
TAKEALOT_API_KEY=replace-with-your-takealot-api-key
TAKEALOT_API_BASE_URL=https://seller-api.takealot.com/v2
TAKEALOT_SYNC_START_DATE=2018-01-01

# Amazon SP-API
AMAZON_SP_API_REFRESH_TOKEN=replace-with-your-amazon-lwa-refresh-token
AMAZON_SP_API_CLIENT_ID=replace-with-your-amazon-lwa-client-id
AMAZON_SP_API_CLIENT_SECRET=replace-with-your-amazon-lwa-client-secret
AMAZON_SP_API_MARKETPLACE_ID=replace-with-your-amazon-marketplace-id
AMAZON_SP_API_REGION=eu
AMAZON_SP_API_BASE_URL=https://sellingpartnerapi-eu.amazon.com
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_AWS_ACCESS_KEY_ID=replace-with-your-aws-access-key-id
AMAZON_AWS_SECRET_ACCESS_KEY=replace-with-your-aws-secret-access-key

PORT=3000
